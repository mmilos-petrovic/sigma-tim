# Copy to .env.local. `npm run dev` (or `npm run dev:setup`) writes the local values for you, including
# VITE_DEV_LOGIN_PASSWORD, which switches on the development sign-in panel (never part of a production build).
# Values for local development also come from `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

{
  "name": "sigma-tim",
  "private": true,
  "type": "module",
  "devDependencies": {
    "supabase": "^2.122.0"
  },
  "scripts": {
    "db:start": "supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,inbucket",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && node scripts/dev-setup.mjs",
    "db:test": "supabase test db",
    "db:test:concurrency": "bash supabase/tests/concurrency/claim_slot_race.sh",
    "web:dev": "npm --prefix web run dev",
    "dev": "npm run db:start && npm run dev:setup && npm run web:dev",
    "install:all": "npm install && npm --prefix web install",
    "lint": "npm --prefix web run lint",
    "typecheck": "npm --prefix web run typecheck",
    "dev:setup": "node scripts/dev-setup.mjs",
    "test": "npm --prefix web test"
  }
}
